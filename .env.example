# 2026-11-05 14:41 KST
# 이 파일을 .env 로 복사하고 아래 중 하나에 키를 넣으세요. (.env 는 git에 올라가지 않습니다.)
# 이 파일(.env.example)에는 키를 넣지 마세요.
# 여러 개를 넣으면 Anthropic, OpenRouter, Gemini 순으로 씁니다.

# 무료: Gemini 키 https://aistudio.google.com/apikey
# (무료 등급에 보낸 사진은 Google 제품 개선에 쓰일 수 있습니다.)
GEMINI_API_KEY=

# 유료: Anthropic 키 https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# 유료: OpenRouter 키 https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=

# 배포한 앱 주소 (가족 공유 링크가 가리킬 주소). 비우면 지금 열린 주소를 씁니다.
# 예: VITE_PUBLIC_URL=https://아이디.github.io/저장소이름/
VITE_PUBLIC_URL=
